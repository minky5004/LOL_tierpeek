# Riot API
RIOT_API_KEY=RGAPI-xxxx-xxxx-xxxx

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/loltracker
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_LOLTRACKER=DEBUG